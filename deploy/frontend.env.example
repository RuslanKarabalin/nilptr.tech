# Frontend environment for LOCAL DEVELOPMENT ONLY. docker compose reads
# this file directly; overrides go into deploy/.env.frontend (ignored by
# git). Production values live in the frontend-config ConfigMap.
#
# Open the site through the compose proxy on port 8000, which routes /api
# and /files to the backend like Traefik. There is no ORIGIN here: the
# public address comes from the X-Forwarded-Host and X-Forwarded-Proto
# headers set by the proxy, so both http://localhost:8000 and
# http://127.0.0.1:8000 pass the SvelteKit CSRF check on form posts.
# This is safe only because the frontend port is not published.
# When running the frontend natively set ORIGIN=http://localhost:5173 and
# BACKEND_URL=http://localhost:8080 instead.

PORT=3000
HOST_HEADER=X-Forwarded-Host
PROTOCOL_HEADER=X-Forwarded-Proto
BACKEND_URL=http://backend:8080
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
# Uploads stream through SvelteKit form actions (adapter-node default 512K).
BODY_SIZE_LIMIT=1100M
